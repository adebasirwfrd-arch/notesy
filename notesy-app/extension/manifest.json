{
  "manifest_version": 3,
  "name": "Notesy — Meeting Notes",
  "short_name": "Notesy",
  "version": "0.1.0",
  "description": "Rekam rapat (layar + audio), transkrip lokal, slide otomatis, dan ringkasan AI lewat Cursor.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Buka Notesy",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.cursor.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "open-notesy": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Buka Notesy"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
