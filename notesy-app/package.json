{
  "name": "notesy-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "assets": "node scripts/copy-ort.mjs && node scripts/make-icons.mjs",
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && tsc --noEmit && vite build",
    "build:ext": "pnpm assets && tsc --noEmit && vite build --mode extension && node scripts/pack-extension.mjs",
    "build:android": "pnpm assets && tsc --noEmit && vite build --mode android && npx cap sync android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@huggingface/transformers": "^4.3.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vercel/blob": "^2.8.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/chrome": "^0.3.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
